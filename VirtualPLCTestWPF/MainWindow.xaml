<Window x:Class="VirtualPLCTestWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Virtual PLC Test"
        Width="900"
        Height="600"
        MinWidth="700"
        MinHeight="450"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Virtual PLC Test" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Margin="0,6,0,0" Text="버튼을 클릭하면 TestNetWork의 Command 1~8 값을 토글합니다." Foreground="Gray" />
            <TextBlock x:Name="ConnectionStatusText" Margin="0,6,0,0" Text="TestNetWork 연결 대기 중" Foreground="DarkOrange" />
        </StackPanel>

        <UniformGrid Grid.Row="2" Columns="2" Rows="4">
            <Button x:Name="Command1Button" Tag="1" Margin="8" MinHeight="80" Content="Command 1: Position 1 Occupied=OFF" Click="OnCommandClicked" />
            <Button x:Name="Command2Button" Tag="2" Margin="8" MinHeight="80" Content="Command 2: TargetPressure=250" Click="OnCommandClicked" />
            <Button x:Name="Command3Button" Tag="3" Margin="8" MinHeight="80" Content="Command 3: TargetPressure=500" Click="OnCommandClicked" />
            <Button x:Name="Command4Button" Tag="4" Margin="8" MinHeight="80" Content="Command 4: TargetPressure=750" Click="OnCommandClicked" />
            <Button x:Name="Command5Button" Tag="5" Margin="8" MinHeight="80" Content="Command 5: Inspection Position 12 Clear" Click="OnCommandClicked" />
            <Button x:Name="Command6Button" Tag="6" Margin="8" MinHeight="80" Content="Command 6: Value=OFF" Click="OnCommandClicked" />
            <Button x:Name="Command7Button" Tag="7" Margin="8" MinHeight="80" Content="Command 7: Value=OFF" Click="OnCommandClicked" />
            <Button x:Name="Command8Button" Tag="8" Margin="8" MinHeight="80" Content="Command 8: Value=OFF" Click="OnCommandClicked" />
        </UniformGrid>
    </Grid>
</Window>